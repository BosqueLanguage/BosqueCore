namespace Core;

namespace List {
#if STRIPPED_CORE
#else
    function rangeOfNat(start: Nat, end: Nat, step: Nat = 1n, inclusive: Bool = false): List<Nat>
        requires start <= end;
        requires step > 0n;
    {
        return ListOps::s_list_range_nat(start, end, step, inclusive);
    }

    function rangeOfInt(start: Int, end: Int, step: Int = 1i, inclusive: Bool = false): List<Int>
        requires start <= end;
        requires step > 0i;
    {
        return ListOps::s_list_range_int(start, end, step, inclusive);
    }

    function zip<T, U>(l1: List<T>, l2: List<U>): List<(|T, U|)> 
        requires l1.size() == l2.size();
    {
        let ssize = l1.size();
        if(ssize == 0n) {
            return List<(|T, U|)>{};
        }
        else {
            return ListOps::s_list_zip<T, U, (|T, U|)>(l1, l2, ssize);
        }
    }
#endif  %% STRIPPED_CORE 
}

__internal entity List<T> {
#if STRIPPED_CORE
#else
    method empty(): Bool {
        return ListOps::s_list_empty<T>(this);
    }

    method singleton(): Bool {
        return ListOps::s_list_size<T>(this) == 1n;
    }

    method size(): Nat {
        return ListOps::s_list_size<T>(this);
    }

    method lastIndex(): Nat 
        requires !this.empty();
    {
        return ListOps::s_list_size<T>(this) - 1n;
    }

    method front(): T 
        requires !this.empty();
    {
        return ListOps::s_list_front<T>(this);
    }

    method back(): T 
        requires !this.empty();
    {
        return ListOps::s_list_back<T>(this);
    }

    method single(): T 
        requires this.singleton();
    {
        return ListOps::s_list_front<T>(this);
    }

    method get(i: Nat): T 
        requires i < this.size();
    {
        return ListOps::s_list_get<T>(this, i);
    }

    method pushFront(v: T): List<T> {
        return ListOps::s_list_pushfront<T>(this, v);
    }

    ref method pushFront(v: T) {
        return ListOps::s_list_pushfront_ref<T>(ref this, v);
    }

    method pushBack(v: T): List<T> {
        return ListOps::s_list_pushback<T>(this, v);
    }

    ref method pushBack(v: T) {
        return ListOps::s_list_pushback_ref<T>(ref this, v);
    }

    method insert(i: Nat, v: T): List<T> 
        requires i <= this.size();
    {
        return ListOps::s_list_insert<T>(this, i, v);
    }

    ref method insert(i: Nat, v: T) 
        requires i <= this.size();
    {
        return ListOps::s_list_insert_ref<T>(ref this, i, v);
    }

    method set(i: Nat, v: T): List<T>
        requires i < this.size();
    {
        return ListOps::s_list_set<T>(this, i, v);
    }

    ref method set(i: Nat, v: T)
        requires i < this.size();
    {
        return ListOps::s_list_set_ref<T>(ref this, i, v);
    }

    method deleteFront(): List<T>
        requires !this.empty();
    {
        return ListOps::s_list_deletefront<T>(this);
    }

    ref method deleteFront() 
        requires !this.empty();
    {
        return ListOps::s_list_deletefront_ref<T>(ref this);
    }
    
    method deleteBack(): List<T>
        requires !this.empty();
    {
        return ListOps::s_list_deleteback<T>(this);
    }

    ref method deleteBack() 
        requires !this.empty();
    {
        return ListOps::s_list_deleteback_ref<T>(ref this);
    }

    method append(other: List<T>): List<T> {
        if(ListOps::s_list_empty<T>(this)) {
            return other;
        }
        elif(ListOps::s_list_empty<T>(other)) {
            return this;
        }
        else {
            return ListOps::s_list_append<T>(this, other);
        }
    }

    method prepend(other: List<T>): List<T> {
        if(ListOps::s_list_empty<T>(this)) {
            return other;
        }
        elif(ListOps::s_list_empty<T>(other)) {
            return this;
        }
        else {
            return ListOps::s_list_append<T>(other, this);
        }
    }

    function concat(...lists: List<List<T>>): List<T> {
        if(ListOps::s_list_empty<List<T>>(lists)) {
            return List<T>{};
        }
        else {
            return ListOps::s_list_concat<T>(lists);
        }
    }

    function concatAll(lists: List<List<T>>): List<T> {
        if(ListOps::s_list_empty<List<T>>(lists)) {
            return List<T>{};
        }
        else {
            return ListOps::s_list_concat<T>(lists);
        }
    }

    method {when T: List<U>} flatten<U>(): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
            return ListOps::s_list_concat<U>(this);
        }
    }

    recursive? method allOf(p: recursive? pred(T) -> Bool): Bool {
        if(ListOps::s_list_empty<T>(this)) {
            return true;
        }
        else {
            return ListOps::s_list_allof[recursive?]<T>(this, p);
        }
    }

    recursive? method noneOf(p: recursive? pred(T) -> Bool): Bool {
        if(ListOps::s_list_empty<T>(this)) {
            return true;
        }
        else {
            return ListOps::s_list_noneof[recursive?]<T>(this, p);
        }
    }

    recursive? method someOf(p: recursive? pred(T) -> Bool): Bool {
        if(ListOps::s_list_empty<T>(this)) {
            return false;
        }
        else {
            return ListOps::s_list_someof[recursive?]<T>(this, p);
        }
    }

    recursive? method map<U>(f: recursive? fn(T) -> U): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
            return ListOps::s_list_map[recursive?]<T, U>(this, f);
        }
    }

    recursive? method mapIdx<U>(f: recursive? fn(T, Nat) -> U): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
            return ListOps::s_list_mapidx[recursive?]<T, U>(this, f);
        }
    }

    recursive? method flatmap<U>(f: recursive? fn(T) -> List<U>): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
            let ll = ListOps::s_list_map[recursive?]<T, List<U>>(this, f);
            return ListOps::s_list_concat<U>(ll);
        }
    }

    recursive? method flatmapIdx<U>(f: recursive? fn(T, Nat) -> List<U>): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
            let ll = ListOps::s_list_mapidx[recursive?]<T, List<U>>(this, f);
            return ListOps::s_list_concat<U>(ll);
        }
    }

    method convert<U>(): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
            return ListOps::s_list_map<T, U>(this, fn(v) => v.@<U>);
        }
    }

    method {when T: Option<U>} convertsome<U>(): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
            return ListOps::s_list_map<T, U>(this, fn(v) => v.@some);
        }
    }

    recursive? method filter(p: recursive? pred(T) -> Bool): List<T> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<T>{};
        }
        else {
            return ListOps::s_list_filter[recursive?]<T>(this, p);
        }
    }

    method filter<U>(): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
           return ListOps::s_list_filtermap<T, U>(this, pred(v) => v.?<U>, fn(v) => v.@<U>);
        }
    }

    method {when T: Option<U>} filtersome<U>(): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
           return ListOps::s_list_filtermap<T, U>(this, pred(v) => v.?some, fn(v) => v.@some);
        }
    }

    recursive? method filtermap<U>(p: recursive? pred(T) -> Bool, f: recursive? fn(T) -> U): List<U> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<U>{};
        }
        else {
            return ListOps::s_list_filtermap[recursive?]<T, U>(this, p, f);
        }
    }

    %%
    %%TODO: filterOk<U>, filterFail<E>, convertOk<U>, convertFail<E> for Result<T, E>
    %%

    method {when T: keytype} min(): T 
        requires !this.empty();
    {
        return ListOps::s_list_min<T>(this);
    }

    recursive? method min(cmp: recursive? pred(T, T) -> Bool): T 
        requires !this.empty();
    {
        return ListOps::s_list_minfun<T>(this, cmp);
    }

    method {when T: keytype} max(): T 
        requires !this.empty();
    {
        return ListOps::s_list_max<T>(this);
    }

    recursive? method max(cmp: recursive? pred(T, T) -> Bool): T 
        requires !this.empty();
    {
        return ListOps::s_list_maxfun<T>(this, cmp);
    }

    method {when T: numeric} sum(): T {
        if(ListOps::s_list_empty<T>(this)) {
            return T::zero;
        }
        else {
            return ListOps::s_list_sum<T>(this);
        }
    }

    method {when T: numeric} sumPrefix(): List<T> {
        if(ListOps::s_list_empty<T>(this)) {
            return List<T>{};
        }
        else {
            return ListOps::s_list_sumPrefix<T>(this);
        }
    }

    recursive? method accumulate(op: recursive? fn(T, T) -> T, init: T): T {
        if(ListOps::s_list_empty<T>(this)) {
            return init;
        }
        else {
            return ListOps::s_list_sumfun<T>(this, init, op);
        }
    }
#endif %% STRIPPED_CORE 
}
