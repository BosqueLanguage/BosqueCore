namespace Core;

datatype JSON of 
    JsonNull {}
    JsonBool {
#if STRIPPED_CORE
#else
        value: Bool;
#endif
    }
    JsonNumber {
#if STRIPPED_CORE
#else
        value: Float; 
#endif
    }
    JsonString { 
#if STRIPPED_CORE
#else
        value: String; 
#endif
    }
    JsonArray { 
#if STRIPPED_CORE
#else
        value: List<JSON>; 
        method count(): Nat { return this.value.size(); }
        method get(i: Nat): JSON { return this.value[i]; }
#endif
    }
    JsonObject {
#if STRIPPED_CORE
#else
        value: Map<String, JSON>; 
        method count(): Nat { return this.value.size(); }
        method haskey(key: String): Bool { return this.value.has(key); }
        method get(key: String): JSON { return this.value.get(key); }
#endif
    }
& {
#if STRIPPED_CORE
#else
    function toByteBuffer(json: JSON): ByteBuffer {
        abort;
    }

    function fromByteBuffer(buffer: ByteBuffer): Option<JSON> {
        abort;
    }

    function toString(json: JSON): String {
        abort;
    }

    function fromString(str: String): Option<JSON> {
        abort;
    }

    //TODO: not clear if CString conversion functions are safe meaningful

    function toStdBAPI<T>(json: JSON): Option<T> {
        abort;
    }

    function fromStdBAPI<T>(value: T): Option<JSON> {
        abort;
    }
#endif
}
