%%The core namespace implements the primitive types used in the Bosque language
declare namespace Core;

%** Special type for indicating a value can be used as a key in a collection. **%
namespace KeyComparator {
    function equal<T: keytype>(a: T, b: T): Bool = @special_method;
    function less<T: keytype>(a: T, b: T): Bool = @special_method;
}

%** Type for representing the option value. **%
__internal concept Option<T> {
}

%** Type for representing the none option value. **%
__internal entity None {
}

%** Type for representing the some option value. **%
__internal entity Some<T> provides Option<T> {
}

%** Primitive boolean value. **%
__internal __typedeclable __keycomparable entity Bool {
#if STRIPPED_CORE
#else
    function toCString(b: Bool): CString {
        return NumericOps::s_boolToCString(b);
    }

    function toString(b: Bool): String {
        return NumericOps::s_boolToString(b);
    }
#endif %% STRIPPED_CORE
}

%** Primitive natural number value. **%
__internal __typedeclable __keycomparable __numeric entity Nat {
#if STRIPPED_CORE
#else
    const zero: Nat = 0n;
    const one: Nat = 1n;

    function square(x: Nat): Nat {
        return x * x;
    }

    function pow(x: Nat, y: Nat): Nat {
        return NumericOps::s_natPow(x, y);
    }

    function toCString(n: Nat): CString {
        return NumericOps::s_natToCString(n);
    }

    function toString(n: Nat): String {
        return NumericOps::s_natToString(n);
    }
#endif %% STRIPPED_CORE
}

%** Primitive integer value. **%
__internal __typedeclable __keycomparable __numeric entity Int {
#if STRIPPED_CORE
#else
    const zero: Int = 0i;
    const one: Int = 1i;

    function square(x: Int): Int {
        return x * x;
    }

    function pow(x: Int, y: Int): Int 
        requires y >= 0i;
    {
        return NumericOps::s_intPow(x, y);
    }

    function toCString(i: Int): CString {
        return NumericOps::s_intToCString(i);
    }

    function toString(i: Int): String {
        return NumericOps::s_intToString(i);
    }
#endif %% STRIPPED_CORE
}

%** Primitive big-natural number value. **%
__internal __typedeclable __keycomparable __numeric entity ChkNat {
    #if STRIPPED_CORE
#else
    const zero: ChkNat = 0N;
    const one: ChkNat = 1N;

    function toCString(n: ChkNat): CString {
        return NumericOps::s_chkNatToCString(n);
    }

    function toString(n: ChkNat): String {
        return NumericOps::s_chkNatToString(n);
    }
#endif %% STRIPPED_CORE
}

%** Primitive big-integer number value. **%
__internal __typedeclable __keycomparable __numeric entity ChkInt {
    #if STRIPPED_CORE
#else
    const zero: ChkInt = 0I;
    const one: ChkInt = 1I;

    function toCString(i: ChkInt): CString {
        return NumericOps::s_chkIntToCString(i);
    }

    function toString(i: ChkInt): String {
        return NumericOps::s_chkIntToString(i);
    }
#endif %% STRIPPED_CORE
}

%** Primitive rational value. **%
__internal __typedeclable __numeric entity Rational {
}

%** Primitive float value. **%
__internal __typedeclable __numeric entity Float {
#if STRIPPED_CORE
#else
    const zero: Float = 0.0f;
    const one: Float = 1.0f;

    const pi: Float = 3.1415926535897931f;
    const e: Float = 2.7182818284590451f;

    function isSafeConvertInto<T: numeric>(f: Float): Bool = @float_is_safe_convert_into;

    function fromNat(n: Nat): Float = @float_from_nat;
    function toNat(f: Float): Nat
        requires Float::isSafeConvertInto<Nat>(f);
    {
        return NumericOps::s_safeConvertFloatInto<Nat>(f);
    }

    function square(x: Float): Float {
        return x * x;
    }

    function pow(x: Float, y: Float): Float 
        requires y < 0.0f ==> x != 0.0f;
    {
        return NumericOps::s_floatPow(x, y);
    }

    function sqrt(x: Float): Float
        requires x >= 0.0f;
    {
        return NumericOps::s_floatSqrt(x);
    }

    function toCString(f: Float): CString {
        return NumericOps::s_floatToCString(f);
    }

    function toString(f: Float): String {
        return NumericOps::s_floatToString(f);
    }
#endif %% STRIPPED_CORE
}

%** Primitive float decimal value. **%
__internal __typedeclable __numeric entity Decimal {
}

%** Primitive decimal degree value. **%
__internal __typedeclable __numeric entity DecimalDegree {
}

%** Primitive latitude/longitude value. **%
__internal __typedeclable entity LatLongCoordinate {
}

%** Primitive complex number value. **%
__internal __typedeclable __numeric entity Complex {
}

%** Byte **%
__internal __typedeclable __keycomparable entity Byte {
}

%** C-Style 8-bit ascii char. **%
__internal __typedeclable __keycomparable __cstrpos entity CChar {
}

%** 32-bit unicode character. **%
__internal __typedeclable __keycomparable __strpos entity UnicodeChar { 
}

%** Primitive UUIDv4 value. **%
__internal __typedeclable __keycomparable entity UUIDv4 {
}

%** Primitive UUIDv7 value. **%
__internal __typedeclable __keycomparable entity UUIDv7 {
}

%** Primitive hash (SHA3 256) value suitable for content addressable operations or crypto secure digests. **%
__internal __typedeclable __keycomparable entity SHAContentHash {
}

%** Primitive string value. **%
__internal __typedeclable __keycomparable __strpos entity String {
#if STRIPPED_CORE
#else
    %** Check if the string is empty **%
    method empty(): Bool {
        return StringOps::s_empty(this);
    }

    %** Get size of String in Unicode code points **%
    method size(): Nat {
        return StringOps::s_size(this);
    }

    %** Get size of String in bytes **%
    method utf8bytes(): Nat {
        return StringOps::s_utf8bytes(this);
    }

    method startsWith<P: strpos>(prefix: P): Bool {
        return StringOps::s_startsWith<P>(this, prefix);
    }

    method endsWith<P: strpos>(prefix: P): Bool {
        return StringOps::s_endsWith<P>(this, prefix);
    }

    %** Append other to this String **%
    method append(other: String): String {
        if(this.empty()) {
            return other;
        }
        elif(other.empty()) {
            return this;
        }
        else {
            return StringOps::s_append(this, other);
        }
    }

    %** Prepend other String to this **%
    method prepend(other: String): String {
        if(this.empty()) {
            return other;
        }
        elif(other.empty()) {
            return this;
        }
        else {
            return StringOps::s_append(other, this);
        }
    }

    function concat(...strings: List<String>): String {
        if(ListOps::s_list_empty<String>(strings)) {
            return "";
        }
        else {
            return ListOps::s_list_concat_strs(strings);
        }
    }

    function concatAll(strings: List<String>): String {
        if(ListOps::s_list_empty<String>(strings)) {
            return "";
        }
        else {
            return ListOps::s_list_concat_strs(strings);
        }
    }

    function join(separator: String, ...strings: List<String>): String 
        requires !separator.empty();
    {
        if(ListOps::s_list_empty<String>(strings)) {
            return "";
        }
        else {
            return ListOps::s_list_join_strs(separator, strings);
        }
    }

    function joinAll(separator: String, strings: List<String>): String 
        requires !separator.empty();
    {
        if(ListOps::s_list_empty<String>(strings)) {
            return "";
        }
        else {
            return ListOps::s_list_join_strs(separator, strings);
        }
    }

    method trim(): String {
        return StringOps::s_trim(this, true, true);
    }

    method trimFront(): String {
        return StringOps::s_trim(this, true, false);
    }
    method trimBack(): String {
        return StringOps::s_trim(this, false, true);
    }

    method split<P: strpos>(separator: P, trim: Bool = false, dropempty: Bool = false): List<String> {
        return StringOps::s_split<P>(this, separator, trim, dropempty);
    }

    function toCString(s: String): Option<CString> {
        var result: CString;
        if(StringOps::s_toCString(s, out? result)) {
            return some(result);
        }
        else {
            return none;
        }
    }

    function fromCString(s: CString): String {
        return StringOps::s_fromCString(s);
    }

    %** Convert a String to a ByteBuffer in utf-8 encoding **%
    function toByteBuffer(s: String): ByteBuffer {
        return StringOps::s_toByteBuffer(s);
    }

    %** Convert a ByteBuffer (assumed utf-8 encoded) to a String. If decoding fails, e.g. incomplete multi-byte character or invalid value, return None. **%
    function fromByteBuffer(bb: ByteBuffer): Option<String> {
        var result: String;
        if(StringOps::s_fromByteBuffer(bb, out? result)) {
            return some(result);
        }
        else {
            return none;
        }
    }

    function toJSONFormat(s: String): String {
        return StringOps::s_toJSON(s);
    }

    function fromJSONFormat(s: String): Option<String> {
        var result: String;
        if(StringOps::s_fromJSON(s, out? result)) {
            return some(result);
        }
        else {
            return none;
        }
    }
#endif %% STRIPPED_CORE
}

%** Primitive string value. **%
__internal __typedeclable __keycomparable __strpos entity CString {
#if STRIPPED_CORE
#else
    %** Check if the string is empty **%
    method empty(): Bool {
        return CStringOps::s_empty(this);
    }

    %** Get size of CString **%
    method size(): Nat {
        return CStringOps::s_size(this);
    }

    method startsWith<P: cstrpos>(prefix: P): Bool {
        return CStringOps::s_startsWith<P>(this, prefix);
    }

    method endsWith<P: cstrpos>(prefix: P): Bool {
        return CStringOps::s_endsWith<P>(this, prefix);
    }

    %** Append other to this CString **%
    method append(other: CString): CString {
        if(this.empty()) {
            return other;
        }
        elif(other.empty()) {
            return this;
        }
        else {
            return CStringOps::s_append(this, other);
        }
    }

    %** Prepend other CString to this **%
    method prepend(other: CString): CString {
        if(this.empty()) {
            return other;
        }
        elif(other.empty()) {
            return this;
        }
        else {
            return CStringOps::s_append(other, this);
        }
    }

    function concat(...strings: List<CString>): CString {
        if(ListOps::s_list_empty<CString>(strings)) {
            return '';
        }
        else {
            return ListOps::s_list_concat_cstrs(strings);
        }
    }

    function concatAll(strings: List<CString>): CString {
        if(ListOps::s_list_empty<CString>(strings)) {
            return '';
        }
        else {
            return ListOps::s_list_concat_cstrs(strings);
        }
    }

    function join(separator: CString, ...strings: List<CString>): CString 
        requires !separator.empty();
    {
        if(ListOps::s_list_empty<CString>(strings)) {
            return '';
        }
        else {
            return ListOps::s_list_join_cstrs(separator, strings);
        }
    }

    function joinAll(separator: CString, strings: List<CString>): CString 
        requires !separator.empty();
    {
        if(ListOps::s_list_empty<CString>(strings)) {
            return '';
        }
        else {
            return ListOps::s_list_join_cstrs(separator, strings);
        }
    }

    method trim(): CString {
        return CStringOps::s_trim(this, true, true);
    }

    method trimFront(): CString {
        return CStringOps::s_trim(this, true, false);
    }
    method trimBack(): CString {
        return CStringOps::s_trim(this, false, true);
    }

    method split<P: cstrpos>(separator: P, trim: Bool = false, dropempty: Bool = false): List<CString> {
        return CStringOps::s_split<P>(this, separator, trim, dropempty);
    }

    function toByteBuffer(s: CString): ByteBuffer {
        return CStringOps::s_toByteBuffer(s);
    }

    %** Convert a ByteBuffer to a CString. If decoding fails, e.g. incomplete multi-byte character or invalid value, return None. **%
    function fromByteBuffer(bb: ByteBuffer): Option<CString> {
        var result: CString;
        if(CStringOps::s_fromByteBuffer(bb, out? result)) {
            return some(result);
        }
        else {
            return none;
        }
    }

    function toJSONFormat(s: CString): CString {
        return CStringOps::s_toJSON(s);
    }

    function fromJSONFormat(s: CString): Option<CString> {
        var result: CString;
        if(CStringOps::s_fromJSON(s, out? result)) {
            return some(result);
        }
        else {
            return none;
        }
    }
#endif %% STRIPPED_CORE
}

__internal __typedeclable entity ByteBuffer {
#if STRIPPED_CORE
#else
#endif %% STRIPPED_CORE
}

%** Primitive unicode regex value. **%
__internal __strpos entity Regex {
    function accepts(re: Regex, s: String): Bool = @regex_accepts;
}

%** Primitive unicode regex value. **%
__internal __cstrpos entity CRegex {
    function accepts(re: CRegex, s: CString): Bool = @cregex_accepts;
}

%** Primitive path value. **%
__internal __typedeclable __keycomparable entity Path {
}

%** Primitive path item value. **%
__internal __typedeclable __keycomparable entity PathFragment {
}

%** Primitive path glob value. **%
__internal __typedeclable __keycomparable entity Glob {
}

%** Result type. **%
__internal concept Result<T, E> {
    __internal entity Ok provides Result<T, E> {
    }

    __internal entity Fail provides Result<T, E> {
    }
}

%** APIResult type. **%
__internal concept APIResult<T> {
    %** Failed internally or postcondition checks -- hard failure can get error UUID, task UUID, and tag **%
    __internal entity Error provides APIResult<T> {
    }

    %** Failed in validation/precondition checks -- additional information in flags hard failure can failed condition and get error UUID, task UUID and tag **%
    __internal entity Rejected provides APIResult<T> {
    }

    %** Failed through access limits -- additional information in flags and failure tags and UUID **%
    __internal entity Denied provides APIResult<T> {
    }

    %** Failed through temp issues (e.g. for timeout or canceled) -- additional information in timeout/cancel flags and failure tags and UUID **%
    __internal entity Dropped provides APIResult<T> {
    }

    %** Successful result T contains the value -- failure in _soft_ validation/precondition/postcondition checks -- additional information **%
    __internal entity Success provides APIResult<T> {
    }
}

namespace Interpolate {
    %** Special declaration of string interpolation function. **%
    function string(): String = @special_method;

    %** Special declaration of cstring interpolation function. **%
    function cstring(): CString = @special_method;
}

namespace XCore {
#if SMT_LIBS
    internal __intrinsic_error function s_blockingfailure<T>(): T = @s_blockingfailure;
#endif
}


