#if EXEC_LIBS
namespace NumericOps {
    function s_boolToCString(b: Bool): CString = @bool_to_cstring;
    function s_natToCString(n: Nat): CString = @nat_to_cstring;
    function s_intToCString(i: Int): CString = @int_to_cstring;
    function s_chkNatToCString(n: ChkNat): CString = @chk_nat_to_cstring;
    function s_chkIntToCString(i: ChkInt): CString = @chk_int_to_cstring;
    function s_floatToCString(f: Float): CString = @float_to_cstring

    __may_fail function s_natPow(x: Nat, y: Nat): Nat = @nat_pow;
    __may_fail function s_intPow(x: Int, y: Int): Int = @int_pow;

    function s_safeConvertFloatInto<T: numeric>(f: Float): T = @float_safe_convert_into;

    __may_fail function s_floatSqrt(v: Float): Float = @float_sqrt;
    __may_fail function s_floatPow(x: Float, y: Float): Float = @float_pow;
}
