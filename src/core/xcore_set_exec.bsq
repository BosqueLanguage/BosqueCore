    function s_set_has<T: keytype>(s: Set<T>, k: T): Bool = @set_has;
    
    function s_set_insert<T: keytype>(s: Set<T>, k: T): Set<T> = @set_insert;
    function s_set_insert_ref<T: keytype>(ref s: Set<T>, k: T) = @set_insert_ref;
