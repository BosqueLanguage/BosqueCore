namespace Core;

#if STRIPPED_CORE
#else
#if EXEC_LIBS

namespace CStringOps {
    function s_empty(s: CString): Bool = @cstring_empty;
    function s_size(s: CString): Nat = @cstring_size;

    function s_startsWith<P: cstrpos>(s: CString, prefix: P): Bool = @cstring_startswith;
    function s_endsWith<P: cstrpos>(s: CString, suffix: P): Bool = @cstring_endswith;

    function s_append(s1: CString, s2: CString): CString = @cstring_append;

    function s_split<P: cstrpos>(s: CString, separator: P, trim: Bool, dropempty: Bool): List<CString> = @cstring_split;
    function s_trim(s: CString, trimFront: Bool, trimBack: Bool): CString = @cstring_trim;

    function s_toByteBuffer(s: CString): ByteBuffer = @cstring_to_bytebuffer;
    function s_fromByteBuffer(bb: ByteBuffer, out? result: CString): Bool = @cstring_from_bytebuffer;
}
#else
#endif %% EXEC_LIBS
#endif %% STRIPPED_CORE