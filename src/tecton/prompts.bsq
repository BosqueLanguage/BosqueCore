namespace Tecton;

entity Prompt {
    %** The path to the component that this prompt is for **%
    field path: ComponentPath;

    %** The type information relevant to this component **%
    field typespp: List<String>;

    %** The type for the actual values we want to generate **%
    field basetype: Assembly::TypeKey;

    %** The JSON schema for the (individual) values we want to generate **%
    field schema: CString;
}

function generatePromptForComponent(component: PrimitiveComponent, typespp: List<String>): Prompt {
    return Prompt{ component.path, typespp, component.oftype, '' };
}
